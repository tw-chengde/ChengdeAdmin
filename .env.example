# Better Auth
BETTER_AUTH_SECRET="請使用 openssl rand -base64 32 產生"
BETTER_AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="Google OAuth Client ID"
AUTH_GOOGLE_SECRET="Google OAuth Client Secret"

# 出口 IP proxy。變數名稱雖為 MOMO_，但 momo SCM 與 mo店+ 兩個平台共用同一組設定，
# 因為兩邊都要求供應商登記固定 IP（momo 於 SCM H1112、mo店+ 於 A103）。
# 兩個變數必須一併設定；未設定時 client 直接連線平台。
MOMO_PROXY_URL=""
MOMO_PROXY_TOKEN=""

# momo 購物網 SCM
MOMO_SCM_ENTP_ID=""
MOMO_SCM_ENTP_CODE=""
MOMO_SCM_ENTP_PASSWORD=""
MOMO_SCM_OTP_BACK_NO=""
# 第三方物流訂單查詢範圍；目前只有新竹物流（62）常溫（01）。
# 如 momo 帳號日後新增可用物流或溫層，以逗號分隔代碼即可。
MOMO_SCM_THIRD_PARTY_DELIVERY_TYPES="62"
MOMO_SCM_THIRD_PARTY_TEMPERATURE_TYPES="01"
# 包材設定
MOMO_SCM_SHIP_PACK="自有包材"
MOMO_SCM_PACK_TYPE="紙箱(袋)"
MOMO_SCM_PACK_UNIT="40"


# mo店+（依規格書 header 固定為 Authorization、值為 "Bearer <JWT>"）
MO_STORE_PLUS_AUTH_VALUE=""
