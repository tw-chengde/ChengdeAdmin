{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chengdeadmin",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"BETTER_AUTH_URL": "https://admin.tw-chengde.com",
		"MOMO_PROXY_URL": "https://momo-proxy-780265451033.asia-east1.run.app",
		"MOMO_SCM_THIRD_PARTY_DELIVERY_TYPES": "62",
		"MOMO_SCM_THIRD_PARTY_TEMPERATURE_TYPES": "01",
		"MOMO_SCM_SHIP_PACK": "自有包材",
		"MOMO_SCM_PACK_TYPE": "紙箱(袋)",
		"MOMO_SCM_PACK_UNIT": "40"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chengde-admin-db",
			"database_id": "f83cd46d-4421-4cfb-9e34-88abc01c7c1f",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}