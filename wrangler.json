{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chengdeadmin",
  "main": "./worker/index.ts",
  "compatibility_date": "2024-11-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "AUTH_TRUST_HOST": "true",
    "AUTH_URL": "https://admin.tw-chengde.com"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
