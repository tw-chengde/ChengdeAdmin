{
  "name": "chengde-admin",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "preview": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state --port 3000",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:create": "wrangler d1 create chengde-admin-db",
    "db:migrate:local": "wrangler d1 migrations apply chengde-admin-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply chengde-admin-db --remote",
    "db:migrations:list": "wrangler d1 migrations list chengde-admin-db --remote",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "better-auth": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.4",
    "vite": "8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true,
    "sharp@0.34.5": true,
    "sharp@0.35.2": true,
    "unrs-resolver@1.11.1": true
  },
  "workspaces": [
    "functions/*"
  ]
}
